{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "portfolio": {
      "projectType": "application",
      "root": "app",
      "sourceRoot": "app",
      "prefix": "jc",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/portfolio",
            "index": "app/index.html",
            "browser": "app/main.ts",
            "tsConfig": "app/tsconfig.app.json",
            "styles": ["app/styles.scss"],
            "assets": [
              { "glob": "**/*", "input": "assets/images", "output": "assets/images" }
            ]
          },
          "configurations": {
            "production": { "outputHashing": "none", "budgets": [{ "type": "initial", "maximumWarning": "550kB", "maximumError": "1MB" }] },
            "development": { "optimization": false, "sourceMap": true, "outputHashing": "none" }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "development": { "buildTarget": "portfolio:build:development" },
            "production": { "buildTarget": "portfolio:build:production" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
